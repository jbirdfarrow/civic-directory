{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbirdfarrow/civic-directory/schema/directory.schema.json",
  "title": "Civic Directory Data",
  "description": "One country file of source-tracked officeholder records (data/countries/XX.json). Every record names its sources and carries a verification status that the app shows to users.",
  "type": "object",
  "required": [
    "schemaVersion",
    "jurisdictionCode",
    "sources",
    "officeholders"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "jurisdictionCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "sourceType",
          "retrievedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceType": {
            "description": "government, legislature, election-authority and official-api count as official. wikidata, news and manual never verify a record on their own.",
            "enum": [
              "government",
              "legislature",
              "election-authority",
              "official-api",
              "wikidata",
              "news",
              "manual"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "archivedUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "officeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "jurisdictionCode",
          "office",
          "person",
          "contacts",
          "sourceIds",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "jurisdictionCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "subdivisionCode": {
            "description": "ISO 3166-2 code for subnational offices, for example AU-NSW. Null for national offices.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          },
          "administrativeArea": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "id",
              "name",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "office": {
            "type": "object",
            "required": [
              "title",
              "level",
              "selectionMethod"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "localTitle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "enum": [
                  "national",
                  "regional",
                  "local",
                  "other"
                ]
              },
              "selectionMethod": {
                "enum": [
                  "elected",
                  "appointed",
                  "hereditary",
                  "unknown"
                ]
              },
              "termStart": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "termEnd": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "additionalProperties": false
          },
          "person": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "localName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "languageCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "email",
                    "phone",
                    "website",
                    "postal-address",
                    "contact-form"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourceId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "status",
              "checkedAt"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "stale",
                  "disputed"
                ]
              },
              "checkedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "verifiedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "verifiedBy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "enum": [
                  "official-source-match",
                  "second-review",
                  "api-sync",
                  null
                ]
              },
              "evidenceSourceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "reviewBy": {
                "description": "Date after which a verified record is shown as stale until someone re-checks it. Usually the next scheduled election or 12 months out.",
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  }
                },
                "then": {
                  "required": [
                    "verifiedAt",
                    "verifiedBy",
                    "method",
                    "evidenceSourceIds",
                    "reviewBy"
                  ],
                  "properties": {
                    "verifiedAt": {
                      "type": "string"
                    },
                    "verifiedBy": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "enum": [
                        "official-source-match",
                        "second-review",
                        "api-sync"
                      ]
                    },
                    "evidenceSourceIds": {
                      "minItems": 1
                    },
                    "reviewBy": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "disputed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "notes"
                  ],
                  "properties": {
                    "notes": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
